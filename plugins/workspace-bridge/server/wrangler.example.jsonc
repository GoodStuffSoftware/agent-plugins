// Example config. Copy to wrangler.jsonc (git-ignored) and replace every placeholder.
// Secrets (GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, TOKEN_KEK, COOKIE_SECRET,
// OWNER_EMAILS, LINKABLE_EMAILS) are set with `wrangler secret put`, not here.
// PUBLIC_URL is the OAuth issuer: your https origin, no trailing slash. OWNER_CONTACT is shown
// on / and /privacy; leave it empty to hide the line.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "workspace-bridge",
  "main": "src/index.ts",
  // Bundles server/theme/ (or $WB_THEME_DIR) into the Worker; see docs/SELF-HOSTING.md, "Theming".
  "build": { "command": "node scripts/build-theme.mjs" },
  "compatibility_date": "2026-10-28",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "routes": [{ "pattern": "mcp.example.com", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "workspace-bridge",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "00000000000000000000000000000000" }],
  "observability": { "enabled": true },
  // DCR_LIMIT limits Dynamic Client Registration (/oauth/register) per client IP; CALL_LIMIT
  // limits tool calls per MCP connection (grant). namespace_id is any integer unique within your
  // account.
  "ratelimits": [
    { "name": "DCR_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "CALL_LIMIT", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } }
  ],
  // Daily cleanup: expired pending actions, flow states and rate counters, old audit rows and
  // expired OAuth data.
  "triggers": { "crons": ["17 3 * * *"] },
  "vars": {
    "PUBLIC_URL": "https://mcp.example.com",
    "OWNER_CONTACT": "",
    // Where the "an action is waiting for your approval" email goes: one address. Empty falls back
    // to OWNER_CONTACT when that is a plain address; with neither, no notice is sent. The notice is
    // sent from the holding mailbox, holds a link and no message content, and approving still needs
    // your sign-in on the bridge.
    "NOTIFY_EMAIL": "",
    "SEND_ENABLED": "false",
    "SETUP_MODE": "true",
    // Which sends wait for your approval: "new_recipients" (default) holds a send when at least one
    // recipient is new to the sending account (not yours, not allow-listed, not sent to before, not
    // in its contacts); "all" holds every send; "off" holds none. Caps, rate limits, SEND_ENABLED
    // and the owner switch apply in every mode. Unset, SEND_REQUIRES_CONFIRM=true means "all".
    "SEND_APPROVAL_MODE": "new_recipients",
    "SEND_REQUIRES_CONFIRM": "false",
    "SEND_PER_HOUR": "20",
    "SEND_PER_DAY": "100",
    "MAX_RECIPIENTS": "20",
    "MAX_ATTACHMENT_BYTES": "524288",
    "MAX_SEND_ATTACHMENT_BYTES": "524288",
    "CURRENT_KEY_VERSION": "1",
    "AUDIT_RETENTION_DAYS": "365"
  }
}
