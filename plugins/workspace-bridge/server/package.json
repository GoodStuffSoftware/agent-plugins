{
  "name": "@goodstuffsoftware/workspace-bridge-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted multi-account Google Workspace MCP server (Cloudflare Worker).",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "build:theme": "node scripts/build-theme.mjs",
    "pretest": "node scripts/build-theme.mjs --check && node --test scripts/theme-lib.test.mjs",
    "test": "vitest run",
    "snapshots": "node scripts/snapshots.mjs",
    "dev": "wrangler dev",
    "deploy:dry": "wrangler deploy --dry-run --config wrangler.example.jsonc --outdir .wrangler/dry-run"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@modelcontextprotocol/server": "2.3.1",
    "agents": "0.31.0",
    "hono": "4.13.14",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@cloudflare/vitest-plugin": "1.4.9",
    "@cloudflare/workers-types": "5.20261028.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.154.0"
  }
}
