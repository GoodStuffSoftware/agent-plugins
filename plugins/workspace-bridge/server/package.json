    "agents": "0.31.0",
    "hono": "4.13.14",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@cloudflare/workers-types": "5.20261028.1",
    "typescript": "7.0.2",
    "vitest": "4.1.12",
    "wrangler": "4.154.0"
